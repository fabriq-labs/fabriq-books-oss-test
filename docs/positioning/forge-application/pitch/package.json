{
  "name": "fabriq-pitch-deck",
  "private": true,
  "version": "1.0.0",
  "description": "Fabriq pitch — Guy Kawasaki 10-slide format (Slidev → PDF)",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md",
    "export:pdf": "slidev export slides.md --output fabriq-pitch.pdf"
  },
  "devDependencies": {
    "@slidev/cli": "0.49.29",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "^1.58.2"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2"
  }
}
