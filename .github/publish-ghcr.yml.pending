# PENDING: move to .github/workflows/publish-ghcr.yml once a token with
# `workflow` scope (classic) or fine-grained "Workflows: Read and write" can push it.
#
# Build the root Dockerfile and push public-facing tags to GHCR.
# Triggers on push to main and manual workflow_dispatch.
#
# Tags:
#   ghcr.io/<owner>/<repo>:latest
#   ghcr.io/<owner>/<repo>:main
#   ghcr.io/<owner>/<repo>:<sha>
#
# Visibility: GITHUB_TOKEN usually cannot change package visibility.
# Make the package public once via the GitHub UI or a PAT with packages admin.

name: Publish (GHCR)

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      no_cache:
        description: Skip Docker layer cache (fresh build)
        default: false
        type: boolean

permissions:
  contents: read
  packages: write

concurrency:
  group: publish-ghcr-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-push:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Monorepo git metadata for image labels
        id: git_meta
        run: |
          MSG_B64=$(git log -1 --format=%B | base64 -w0)
          COMMIT_DATE=$(git log -1 --format=%cI)
          echo "msg_b64=${MSG_B64}" >> "$GITHUB_OUTPUT"
          echo "commit_date=${COMMIT_DATE}" >> "$GITHUB_OUTPUT"

      - name: Image build metadata (time + tag)
        id: build_meta
        run: |
          BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          TAG_TS=$(date -u +%Y%m%d-%H%M%S)
          SAFE_REF=$(echo "${GITHUB_REF_NAME}" | tr '[:upper:]' '[:lower:]' | sed 's#[^a-z0-9._-]#-#g')
          echo "build_time=${BUILD_TIME}" >> "$GITHUB_OUTPUT"
          echo "image_tag=${SAFE_REF}-${TAG_TS}" >> "$GITHUB_OUTPUT"

      - name: Image name (GHCR requires lowercase)
        id: image
        run: |
          OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]')
          echo "image=ghcr.io/${OWNER}/${REPO}" >> "$GITHUB_OUTPUT"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Docker metadata (tags)
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ steps.image.outputs.image }}
          tags: |
            type=raw,value=latest
            type=raw,value=main
            type=sha,format=short
            type=raw,value=${{ github.sha }}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            SOURCE_REF=${{ github.ref_name }}
            SOURCE_COMMIT=${{ github.sha }}
            SOURCE_COMMIT_MESSAGE_B64=${{ steps.git_meta.outputs.msg_b64 }}
            SOURCE_COMMIT_DATE=${{ steps.git_meta.outputs.commit_date }}
            BUILD_TIME=${{ steps.build_meta.outputs.build_time }}
            IMAGE_TAG=${{ steps.build_meta.outputs.image_tag }}
            CACHEBUST=${{ github.sha }}
          no-cache: ${{ inputs.no_cache || false }}
          cache-from: type=gha,scope=fabriq-books-oss-ghcr
          cache-to: type=gha,mode=max,scope=fabriq-books-oss-ghcr

      - name: Attempt public visibility (optional; may require PAT)
        continue-on-error: true
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          OWNER="${{ github.repository_owner }}"
          PKG="${{ github.event.repository.name }}"
          if gh api --method PUT \
            -H "Accept: application/vnd.github+json" \
            "/orgs/${OWNER}/packages/container/${PKG}/visibility" \
            -f visibility=public; then
            echo "Package visibility set to public (org path)."
            exit 0
          fi
          if gh api --method PUT \
            -H "Accept: application/vnd.github+json" \
            "/user/packages/container/${PKG}/visibility" \
            -f visibility=public; then
            echo "Package visibility set to public (user path)."
            exit 0
          fi
          echo "Could not set package visibility with GITHUB_TOKEN (expected). Set public in GitHub UI if needed."
          exit 1
