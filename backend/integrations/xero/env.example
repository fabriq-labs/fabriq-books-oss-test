# Xero Integration Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Xero OAuth Credentials
# Get these from: https://developer.xero.com/app/manage
# =============================================================================
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret

# Tenant ID (organization ID) - get from oauth_setup.py or Xero connections
XERO_TENANT_ID=your_tenant_id

# Start date for historical data sync (REQUIRED - ISO 8601 format)
# This limits the initial sync to records updated after this date.
# Without this, the first run would fetch ALL historical records (could be very slow/large).
XERO_START_DATE=2024-01-01T00:00:00Z

# =============================================================================
# Token Management (Automatic)
# =============================================================================
# NOTE: Access and refresh tokens are automatically managed via .xero_tokens.json
# Run oauth_setup.py once to generate initial tokens, then tokens will be
# automatically refreshed when they expire. You do NOT need to set these in .env:
# - XERO_ACCESS_TOKEN (managed automatically)
# - XERO_REFRESH_TOKEN (managed automatically)

# =============================================================================
# PostgreSQL Database Connection
# =============================================================================
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Optional: Default schema for DBT
DB_SCHEMA=public

# =============================================================================
# Pipeline Control (Optional)
# =============================================================================
# Force full refresh (ignore incremental state)
FORCE_FULL_REFRESH=false

# Skip extraction (run DBT only)
SKIP_EXTRACTION=false

# Skip DBT (run extraction only)
SKIP_DBT=false

# DBT: Force process all records (not just incremental)
FORCE_PROCESS_ALL=false

# Multi-tenant org ID (for DBT models)
org_id=org_default

