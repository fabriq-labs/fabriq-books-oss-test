# Zoho Books Integration Environment Variables
# Copy this file to .env and fill in your values
#
# NOTE: This .env file is for the forward sync (Zoho → Fabriq) in integrations/zoho_books/
# Reverse sync (Fabriq → Zoho) uses the repo root .env file

# =============================================================================
# Zoho OAuth Credentials
# Get these from: https://api-console.zoho.com/
# These are the same credentials used for Airbyte integration
# =============================================================================
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# Redirect URI (must match what's registered in Zoho Developer Console)
# Common values: http://localhost:8080 or https://yourdomain.com/callback
ZOHO_REDIRECT_URI=http://localhost:8080

# Zoho Accounts Domain (optional - defaults to US)
# Options: accounts.zoho.com, accounts.zoho.com.au, accounts.zoho.eu, 
#          accounts.zoho.in, accounts.zoho.com.cn, accounts.zoho.jp
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# =============================================================================
# Zoho Books Organization & API Configuration
# =============================================================================
# Organization ID (optional - will be auto-fetched if not provided)
# Find it in Zoho Books: Settings > Organization > Organization ID
# Or use GET /organizations API endpoint
ZOHO_ORGANIZATION_ID=your_organization_id

# API Domain (optional - defaults to US)
# Select based on your Zoho data center:
# - US: www.zohoapis.com (default)
# - Europe: www.zohoapis.eu
# - India: www.zohoapis.in
# - Australia: www.zohoapis.com.au
# - Japan: www.zohoapis.jp
# - Canada: www.zohoapis.ca
# - China: www.zohoapis.com.cn
# - Saudi Arabia: www.zohoapis.sa
ZOHO_API_DOMAIN=www.zohoapis.com

# =============================================================================
# Token Management (Automatic)
# =============================================================================
# NOTE: Access and refresh tokens are automatically managed via .zoho_tokens.json
# Tokens will be automatically refreshed when they expire. You do NOT need to set these in .env:
# - ZOHO_ACCESS_TOKEN (managed automatically)
# - ZOHO_REFRESH_TOKEN (managed automatically, but initial value required above)

# =============================================================================
# PostgreSQL Database Connection
# =============================================================================
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Optional: Default schema for DBT
DB_SCHEMA=public

# =============================================================================
# Pipeline Control (Optional)
# =============================================================================
# Force full refresh (ignore incremental state)
FORCE_FULL_REFRESH=false

# Skip extraction (run DBT only)
SKIP_EXTRACTION=false

# Skip DBT (run extraction only)
SKIP_DBT=false

# DBT: Force process all records (not just incremental)
FORCE_PROCESS_ALL=false

# Multi-tenant org ID (for DBT models)
org_id=org_default

# Start date for historical data sync (optional - ISO 8601 format)
# This limits the initial sync to records modified after this date.
# Without this, the first run would fetch ALL historical accounts (could be very slow/large).
ZOHO_START_DATE=2024-01-01T00:00:00Z

# =============================================================================
# Notes
# =============================================================================
# 1. The same OAuth credentials (client_id, client_secret, refresh_token) 
#    used for Airbyte can be reused here.
#
# 2. Access tokens are automatically refreshed when they expire (typically 1 hour).
#    No manual token management needed.
#
# 3. If ZOHO_ORGANIZATION_ID is not set, the system will automatically fetch
#    the first organization from your Zoho account.
#
# 4. Make sure your Zoho app has the following scopes:
#    - ZohoBooks.fullaccess.all (or ZohoBooks.chartofaccounts.READ)

