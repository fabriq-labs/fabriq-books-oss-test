# Copy to .env and fill in. Run from backend/integrations with:
#   set -a && source sync_service/.env && set +a
#   PYTHONPATH=. uvicorn sync_service.main:app --host 0.0.0.0 --port 8080
#
# POST /sync: X-API-Key is the user's api_key hash from Fabriq (backend forwards it); Python validates against DB.

# Same Postgres as Fabriq (dbt + source_system.extraction_config)
DATABASE_URL=

# Same 32-byte base64 key as Fabriq backend (ERP_CONFIG_ENCRYPTION_KEY) — required to decrypt extraction_config
ERP_CONFIG_ENCRYPTION_KEY=

# Optional: default Airbyte API host (per-connection override in extraction_config.api_base)
# AIRBYTE_API_BASE=https://api.airbyte.com

# Optional: run DBT only without calling Airbyte (local testing)
# SKIP_AIRBYTE=true

# Airbyte client_id, client_secret, and Airbyte connection UUID are stored per connection in
# source_system.extraction_config (type: airbyte), not in this file.
