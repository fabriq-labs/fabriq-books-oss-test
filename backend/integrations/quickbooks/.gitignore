# DBT specific ignores for all dbt folders under integrations
**/dbt/target/
**/dbt/dbt_packages/
**/dbt/logs/

# DBT temporary files
**/dbt/.dbt/
**/dbt/dbt_modules/

# Python
**/__pycache__/
**/*.pyc
**/dbt/*.pyo
**/dbt/*.pyd
**/dbt/.Python
**/dbt/*.so

# Environment files
**/dbt/env
**/dbt/.env
**/dbt/.env.local
**/dbt/.env.*.local

# IDE files
**/dbt/.vscode/
**/dbt/.idea/
**/dbt/*.swp
**/dbt/*.swo

# OS files
**/dbt/.DS_Store
**/dbt/Thumbs.db

# DBT artifacts
**/dbt/*.manifest.json
**/dbt/*.catalog.json
**/dbt/*.sources.json
**/dbt/run_results.json
**/dbt/perf_info.json

# Temporary files
**/dbt/*.tmp
**/dbt/*.temp

# DBT documentation
**/dbt/target/docs/
