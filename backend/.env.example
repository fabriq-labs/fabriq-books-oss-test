# Prefer the repo-root `.env` (see /.env.example) so backend + integrations share one file.
# This file remains valid if you only run the Node API locally.

DATABASE_URL=postgresql://kernel:kernel@localhost:5432/kernel_app
JWT_SECRET=change-me-to-a-long-random-string
AUTH_PROVIDER=local
PORT=4000
NODE_ENV=development

# Optional
# LOG_LEVEL=warn
# PRISMA_SHOW_QUERY=false
# ERP_CONFIG_ENCRYPTION_KEY=

# Deploy token for the Railway CLI. The API does not read it.
# RAILWAY_TOKEN=
