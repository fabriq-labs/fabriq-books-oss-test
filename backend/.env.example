# Copy to backend/.env. Do not commit backend/.env.
# PostgreSQL is external. setup:kernel and the API both read DATABASE_URL from this file.

DATABASE_URL=postgresql://kernel:kernel@localhost:5432/kernel_app
JWT_SECRET=change-me-to-a-long-random-string
AUTH_PROVIDER=local
PORT=4000
NODE_ENV=development

# Optional
# LOG_LEVEL=warn
# PRISMA_SHOW_QUERY=false

# Deploy token for the Railway CLI. The API does not read it.
# Put it in the repo-root .env or here. Both files are gitignored.
# RAILWAY_TOKEN=
