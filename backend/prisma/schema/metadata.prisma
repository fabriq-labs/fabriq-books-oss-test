model org {
  id                  String           @id @default(dbgenerated("'org_' || gen_random_uuid()"))
  name                String
  slug                String           @unique // Short unique identifier for the organization
  external_code       String?
  created_at          DateTime         @default(now())
  modified_at         DateTime         @updatedAt @map("updated_at")
  settings            String
  logo                String?
  external_mapping    Json?            @default("{}")
  customer_timezone   String?
  active_subscription Boolean          @default(false)
  basecurrency_id     String?
  base_currency       String?          @default("USD") // ISO 4217 code for the org's reporting currency
  erp_system_type     String? // ERP system type for this organization (e.g., 'zoho_books', 'xero', 'quickbooks')
  currency_master     currency_master? @relation(fields: [basecurrency_id], references: [id])
  users               user[]           @relation("UserOrg")

  @@map("organizations")
}

model user {
  id                       String                 @id @default(dbgenerated("'user_' || gen_random_uuid()"))
  email                    String                 @unique
  name                     String?
  password                 String? // For internal auth provider
  external_id              String                 @unique @map("auth_id") // For external auth systems
  auth_provider            String? // e.g., 'clerk', 'supertokens', 'internal'
  created_at               DateTime               @default(now())
  modified_at              DateTime               @updatedAt
  created_by               String? // Reference to user.id
  modified_by              String? // Reference to user.id
  org_id                   String?
  org                      org?                   @relation("UserOrg", fields: [org_id], references: [id])
  manager_id               String? // Reference to manager's user id
  manager                  user?                  @relation("ManagerReport", fields: [manager_id], references: [id])
  reports                  user[]                 @relation("ManagerReport")
  role_users               role_user[]            @relation("UserToRoleUser")
  wf_histories             workflow_history[]     @relation("workflow_action")
  comments                 comment[]              @relation("UserComments")
  department_id            String?                @db.VarChar(50)
  prs_created              purchase_requisition[] @relation(name: "created_user")
  prs_behalf               purchase_requisition[] @relation(name: "behalf_user")
  department               department?            @relation(fields: [department_id], references: [id])
  employees                employee_master[]      @relation("EmployeeUserRelation")
  managers                 employee_master[]      @relation("ManagerRelation")
  assigned_workflow_states workflow_state[]       @relation("AssignedUserToWorkflowState")
  external_config          Json?                  @default("{}") // For storing external service configurations (e.g., Slack user ID)
  api_key                  String?                @db.VarChar(255) // Bcrypt-hashed API key for programmatic access

  @@map("user")
}

model role {
  id              String            @id @default(dbgenerated("'role_' || gen_random_uuid()"))
  name            String            @unique
  created_at      DateTime          @default(now())
  modified_at     DateTime          @updatedAt @map("updated_at")
  created_by      String? // Reference to user.id
  modified_by     String? // Reference to user.id
  org_id          String?
  role_users      role_user[]       @relation("RoleToRoleUser")
  role_views      role_view[]       @relation("RoleToRoleView")
  workflow_states workflow_state[]  @relation("RoleToWorkflowState")
  employees       employee_master[]

  @@map("role")
}

model view {
  id              String            @id @default(dbgenerated("'view_' || gen_random_uuid()"))
  name            String
  model_name      String // The name of the model this view is for
  description     String?
  created_at      DateTime          @default(now())
  modified_at     DateTime          @updatedAt @map("updated_at")
  created_by      String? // Reference to user.id
  modified_by     String? // Reference to user.id
  org_id          String?
  role_views      role_view[]       @relation("ViewToRoleView")
  permissions     permission[]      @relation("ViewToPermission")
  data_graph      Json? // default data graph to be returned
  prompt_template prompt_template[]

  @@map("view")
}

model role_view {
  id          String   @id @default(dbgenerated("'rovi_' || gen_random_uuid()"))
  role_id     String
  view_id     String
  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt @map("updated_at")
  created_by  String? // Reference to user.id
  modified_by String? // Reference to user.id
  org_id      String?
  role        role     @relation("RoleToRoleView", fields: [role_id], references: [id], onDelete: Cascade)
  view        view     @relation("ViewToRoleView", fields: [view_id], references: [id], onDelete: Cascade)

  @@unique([role_id, view_id])
}

model role_user {
  id          String   @id @default(dbgenerated("'rous_' || gen_random_uuid()"))
  role_id     String
  user_id     String
  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt @map("updated_at")
  created_by  String? // Reference to user.id
  modified_by String? // Reference to user.id
  org_id      String?
  role        role     @relation("RoleToRoleUser", fields: [role_id], references: [id], onDelete: Cascade)
  user        user     @relation("UserToRoleUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([role_id, user_id])
}

model permission {
  id          String   @id @default(dbgenerated("'perm_' || gen_random_uuid()"))
  view_id     String
  field_name  String
  access      String // 'read', 'write', 'none'
  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt @map("updated_at")
  created_by  String? // Reference to user.id
  modified_by String? // Reference to user.id
  org_id      String?
  view        view     @relation("ViewToPermission", fields: [view_id], references: [id], onDelete: Cascade)

  @@unique([view_id, field_name])
}

// Abstract model for common fields
model base_model {
  id                String             @id @default(dbgenerated("'base_' || gen_random_uuid()"))
  created_by        String?
  modified_by       String?
  created_at        DateTime           @default(now())
  modified_at       DateTime           @updatedAt
  org_id            String?
  wf_instance_id    String?
  workflow_instance workflow_instance? @relation(fields: [wf_instance_id], references: [id])

  @@map("base_model")
}

model workflow_flow {
  id          String              @id @default(dbgenerated("'flow_' || gen_random_uuid()"))
  name        String              @unique
  model_name  String // e.g., "invoice"
  description String?
  is_active   Boolean             @default(true)
  created_by  String?
  modified_by String?
  created_at  DateTime            @default(now())
  modified_at DateTime            @default(now())
  org_id      String?
  states      workflow_state[]
  instances   workflow_instance[]

  @@map("workflow_flow")
}

model workflow_state {
  id                   String              @id @default(dbgenerated("'wsta_' || gen_random_uuid()"))
  flow_id              String
  name                 String
  description          String?
  sequence             Int                 @default(0) // Display order, fallback to created_at if same
  is_initial           Boolean             @default(false)
  is_final             Boolean             @default(false)
  is_active            Boolean             @default(true)
  skip                 Boolean             @default(false) // If true, automatically skip this state
  skip_target_state_id String? // Target state to skip to (required if skip=true and multiple actions exist)
  entry_conditions     Json? // Conditions that must be met to enter this state
  exit_conditions      Json? // Conditions that must be met to exit this state
  assigned_for         String // 'ROLE', 'USER', or 'EXPRESSION'
  assigned_role_id     String? // Reference to role.id when assigned_for is 'ROLE'
  assigned_user_id     String? // Reference to user.id when assigned_for is 'USER'
  assigned_expression  String? // Expression to evaluate when assigned_for is 'EXPRESSION'
  created_by           String?
  modified_by          String?
  created_at           DateTime            @default(now())
  modified_at          DateTime            @default(now())
  org_id               String?
  flow                 workflow_flow       @relation(fields: [flow_id], references: [id])
  source_actions       workflow_action[]   @relation("source_state")
  target_actions       workflow_action[]   @relation("target_state")
  assigned_role        role?               @relation("RoleToWorkflowState", fields: [assigned_role_id], references: [id])
  assigned_user        user?               @relation("AssignedUserToWorkflowState", fields: [assigned_user_id], references: [id])
  skip_target_state    workflow_state?     @relation("SkipTargetState", fields: [skip_target_state_id], references: [id])
  skipped_by_states    workflow_state[]    @relation("SkipTargetState")
  from_history         workflow_history[]  @relation("FromStateHistory")
  to_history           workflow_history[]  @relation("ToStateHistory")
  instances            workflow_instance[] @relation("StateToInstance")

  @@map("workflow_state")
}

model workflow_action {
  id              String             @id @default(dbgenerated("'wact_' || gen_random_uuid()"))
  name            String
  description     String?
  source_state_id String
  target_state_id String
  conditions      Json? // Conditions that must be met to perform this action
  side_effects    Json? // Additional actions to perform when this action is taken
  created_by      String?
  modified_by     String?
  created_at      DateTime           @default(now())
  modified_at     DateTime           @default(now())
  org_id          String?
  source_state    workflow_state     @relation("source_state", fields: [source_state_id], references: [id])
  target_state    workflow_state     @relation("target_state", fields: [target_state_id], references: [id])
  history         workflow_history[]
}

model workflow_instance {
  id                    String                 @id @default(dbgenerated("'wins_' || gen_random_uuid()"))
  flow_id               String
  model_id              String // ID of the actual model instance (e.g., invoice_id)
  current_state         String
  current_state_id      String? // Reference to workflow_state.id
  assigned_user_id      String? // The user assigned to this instance in current state
  status                String // active, completed, cancelled
  created_by            String?
  modified_by           String?
  created_at            DateTime               @default(now())
  modified_at           DateTime               @default(now())
  org_id                String
  flow                  workflow_flow          @relation(fields: [flow_id], references: [id])
  current_state_ref     workflow_state?        @relation("StateToInstance", fields: [current_state_id], references: [id])
  history               workflow_history[]
  base_models           base_model[]
  comments              comment[]              @relation("wf_comments")
  purchase_requisitions purchase_requisition[]
  purchase_orders       purchase_order[]
  invoices              invoice[]
  sales_orders          sales_order[]

  @@map("workflow_instance")
}

model workflow_history {
  id                 String             @id @default(dbgenerated("'whis_' || gen_random_uuid()"))
  instance_id        String
  action_id          String
  from_state         String
  from_state_id      String?
  to_state           String
  to_state_id        String?
  performed_by       String // user_id
  performed_at       DateTime           @default(now())
  performed_by_name  String?
  performed_by_email String?
  org_id             String
  comments           String?
  metadata           Json? // Additional data about this transition
  skipped_states     Json? // Array of state IDs that were skipped during this transition
  instance           workflow_instance? @relation(fields: [instance_id], references: [id])
  action             workflow_action?   @relation(fields: [action_id], references: [id])
  from_state_ref     workflow_state?    @relation("FromStateHistory", fields: [from_state_id], references: [id])
  to_state_ref       workflow_state?    @relation("ToStateHistory", fields: [to_state_id], references: [id])
  performed_by_user  user?              @relation("workflow_action", fields: [performed_by], references: [id])

  @@map("workflow_history")
}

model comment {
  id             String   @id @default(dbgenerated("concat('comm_', gen_random_uuid())")) @db.VarChar(50)
  created_by     String
  created_at     DateTime @default(now())
  history_id     String?
  comment        String
  wf_instance_id String?
  org_id         String

  wf_instance workflow_instance? @relation("wf_comments", fields: [wf_instance_id], references: [id])
  user        user?              @relation("UserComments", fields: [created_by], references: [id])
}

// model_prompt functionality is now handled by the view table
// The view table can store prompt templates in the data_graph field

model prompt_template {
  id          String    @id @default(dbgenerated("'ptem_' || gen_random_uuid()"))
  view_id     String
  prompt_type String // e.g., 'default', 'edit', 'basicinfo'
  prompt_text String // The actual template string
  is_default  Boolean   @default(false) // Indicates default template
  version     Int       @default(1) // Used to track revisions
  priority    Int       @default(0) // Controls merge/display order
  context     String? // Optional notes or description
  created_by  String? // Reference to user.id
  modified_by String? // Reference to user.id
  created_at  DateTime  @default(now())
  modified_at DateTime?
  org_id      String?
  app_name    String?
  view        view      @relation(fields: [view_id], references: [id], onDelete: Cascade)
}

model source_system {
  id                            String    @id @default(dbgenerated("'srcsys_' || gen_random_uuid()")) @db.VarChar(50)
  org_id                        String    @db.VarChar(50) // Required, one connection per org per system
  system_type                   String    @db.VarChar(255)
  name                          String    @db.VarChar(255)
  region                        String?   @db.VarChar(255)
  connector_version             String?   @db.VarChar(255)
  connection_config             Json      @db.JsonB // Encrypted OAuth credentials only (encrypted via custom Prisma middleware)
  extraction_config             Json?     @db.JsonB // Encrypted Airbyte API credentials + connection id (same encryption as connection_config)
  is_active                     Boolean?  @default(true)
  default_purchase_account_id   String?   @db.VarChar(255)
  default_purchase_account_name String?   @db.VarChar(255)
  last_sync_at                  DateTime?
  last_sync_status              Json?     @db.JsonB
  created_at                    DateTime  @default(now())
  modified_at                   DateTime  @default(now()) @updatedAt
  created_by                    String?   @db.VarChar(255)
  modified_by                   String?   @db.VarChar(255)

  @@unique([org_id, system_type]) // One connection per org per ERP type
  @@map("source_system")
}
