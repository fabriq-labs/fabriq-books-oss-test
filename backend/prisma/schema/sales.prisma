model sales_order {
  id                 String    @id @default(dbgenerated("concat('so_', gen_random_uuid())")) @db.VarChar(50)
  so_number          String?   @unique
  so_date            DateTime? @default(now())
  customer_id        String?
  location_id        String?
  total_amount       Float?    @default(0.00)
  status             String?
  notes              String?
  wf_instance_id     String?
  payment_terms_id   String?
  shipping_method_id String?
  shipping_terms_id  String?

  created_by           String?
  created_at           DateTime?          @default(now())
  modified_by          String?
  modified_at          DateTime?          @default(now()) @updatedAt
  org_id               String?
  assigned_to          String?
  name                 String?
  // Lineage fields for data integration tracking
  source_system_id     String?            @default("srcsys_fabriq") // FK to datalake.source_system (default: fabriq for internal records)
  source_record_id     String? // Source system record ID (e.g., Zoho salesorder_id)
  source_updated_at    DateTime?          @default(now()) // Last updated in source system (default: now() for internal records)
  ingest_batch_id      String? // FK to datalake.sync_batch
  terms_and_conditions String?
  // Relations
  workflow_instance    workflow_instance? @relation(fields: [wf_instance_id], references: [id])
  customer             customers?         @relation(fields: [customer_id], references: [id])
  location             location?          @relation(fields: [location_id], references: [id])
  payment_terms        payment_terms?     @relation(fields: [payment_terms_id], references: [id])
  shipping_method      shipping_method?   @relation(fields: [shipping_method_id], references: [id])
  shipping_terms       shipping_terms?    @relation(fields: [shipping_terms_id], references: [id])
  sales_order_items    sales_order_item[]
  invoice              invoice[]
  delivery_challans    delivery_challan[]
  credit_note          credit_note[]
  quote                quote[]

  @@index([source_system_id, source_record_id])
  @@index([source_updated_at])
  @@map("sales_order")
}

model sales_order_item {
  id               String    @id @default(dbgenerated("concat('so_item_', gen_random_uuid())")) @db.VarChar(50)
  sales_order_id   String?
  item_master_id   String?
  item_name        String?
  item_description String?
  item_type        String?
  quantity         Float?
  rate             Float?
  line_total       Float?
  uom              String?
  item_number      String?
  created_by       String?
  created_at       DateTime? @default(now())
  modified_by      String?
  modified_at      DateTime? @default(now()) @updatedAt
  org_id           String?
  assigned_to      String?
  name             String?
  tax_rate         Float?
  tax_rate_intra   Float?
  tax_amount       Float?
  discount_rate    Float?
  discount_amount  Float?

  // Relations
  sales_order            sales_order?            @relation(fields: [sales_order_id], references: [id])
  item_master            item_master?            @relation(fields: [item_master_id], references: [id])
  delivery_challan_items delivery_challan_item[]

  @@map("sales_order_item")
}

// 'SCHEDULED', 'IN_TRANSIT', 'DELIVERED', 'PARTIALLY_DELIVERED', 'FAILED'
enum delivery_status {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
}

enum delivery_status_for_delivery_challan_item {
  PENDING
  PARTIALLY_DELIVERED
  FULLY_DELIVERED
}

enum challan_type {
  DELIVERY
  REPLACEMENT
  RETURN
  JOB_WORK
  STOCK_TRANSFER
  SAMPLE
  EXHIBITION_DEMO
  APPROVAL
  CONSIGNMENT
}

model delivery_challan {
  id                      String                  @id @default(dbgenerated("concat('dc_', gen_random_uuid())")) @db.VarChar(50)
  challan_number          String?                 @unique
  challan_date            DateTime?               @default(now())
  challan_type            challan_type?
  sales_order_id          String?
  customer_id             String?
  location_id             String?
  delivery_status         delivery_status?
  delivery_date           DateTime?
  driver_name             String?
  vehicle_number          String?
  reference_number        String?
  delivery_notes          String?
  notes                   String?
  partial_delivery_reason String?
  terms_and_conditions    String?
  created_by              String?
  created_at              DateTime?               @default(now())
  modified_by             String?
  modified_at             DateTime?               @default(now()) @updatedAt
  org_id                  String?
  assigned_to             String?
  name                    String?
  total_amount            Float?
  status                  String?
  // Relations
  sales_order             sales_order?            @relation(fields: [sales_order_id], references: [id])
  customer                customers?              @relation(fields: [customer_id], references: [id])
  location                location?               @relation(fields: [location_id], references: [id])
  delivery_challan_items  delivery_challan_item[]

  @@map("delivery_challan")
}

model delivery_challan_item {
  id                  String                                     @id @default(dbgenerated("concat('dc_item_', gen_random_uuid())")) @db.VarChar(50)
  delivery_challan_id String
  sales_order_item_id String?
  item_master_id      String?
  item_code           String?
  item_name           String?
  item_description    String?
  item_type           String?
  quantity_ordered    Float?
  quantity_delivered  Float?
  quantity_pending    Float?
  uom                 String?
  rate                Float?
  tax_rate            Float?
  tax_amount          Float?
  discount_rate       Float?
  discount_amount     Float?
  line_total          Float?
  delivery_status     delivery_status_for_delivery_challan_item?
  backorder_quantity  Float?
  created_by          String?
  created_at          DateTime?                                  @default(now())
  modified_by         String?
  modified_at         DateTime?                                  @default(now()) @updatedAt
  org_id              String?
  assigned_to         String?
  name                String?
  // Relations
  delivery_challan    delivery_challan                           @relation(fields: [delivery_challan_id], references: [id])
  sales_order_item    sales_order_item?                          @relation(fields: [sales_order_item_id], references: [id])
  item_master         item_master?                               @relation(fields: [item_master_id], references: [id])

  @@map("delivery_challan_item")
}

model credit_note {
  id                   String             @id @default(dbgenerated("concat('cn_', gen_random_uuid())")) @db.VarChar(50)
  credit_note_number   String?            @unique
  credit_note_date     DateTime           @default(now())
  credit_note_version  Int?
  credit_note_status   String?
  credit_note_type     String?
  customer_id          String?
  location_id          String?
  invoice_id           String?
  sales_order_id       String?
  account_id           String?
  credit_note_total    Float?
  balance_amount       Float?
  reason               String?
  notes                String?
  terms_and_conditions String?
  name                 String?
  status               String?
  created_by           String?
  created_at           DateTime?          @default(now())
  modified_by          String?
  modified_at          DateTime?          @default(now()) @updatedAt
  org_id               String?
  assigned_to          String?
  // Relations
  customers            customers?         @relation(fields: [customer_id], references: [id])
  location             location?          @relation(fields: [location_id], references: [id])
  invoice              invoice?           @relation(fields: [invoice_id], references: [id])
  sales_order          sales_order?       @relation(fields: [sales_order_id], references: [id])
  account              account?           @relation(fields: [account_id], references: [id])
  credit_note_item     credit_note_item[]

  @@map("credit_note")
}

model credit_note_item {
  id                   String             @id @default(dbgenerated("concat('cn_item_', gen_random_uuid())")) @db.VarChar(50)
  credit_note_id       String
  item_master_id       String?
  invoice_line_item_id String?
  item_name            String?
  item_number          String?
  item_description     String?
  item_type            String?
  rate                 Float?
  quantity             Float?
  line_total           Float?
  tax_rate             Float?
  discount_rate        Float?
  discount_amount      Float?
  tax_amount           Float?
  tax_rate_intra       Float?
  uom                  String?
  name                 String?
  created_by           String?
  created_at           DateTime           @default(now())
  modified_by          String?
  modified_at          DateTime           @default(now()) @updatedAt
  org_id               String?
  assigned_to          String?
  // Relations
  credit_note          credit_note        @relation(fields: [credit_note_id], references: [id])
  item_master          item_master?       @relation(fields: [item_master_id], references: [id])
  invoice_line_item    invoice_line_item? @relation(fields: [invoice_line_item_id], references: [id])

  @@map("credit_note_item")
}

model quote {
  id                   String          @id @default(dbgenerated("concat('quote_', gen_random_uuid())")) @db.VarChar(50)
  quote_number         String?         @unique
  quote_date           DateTime?       @default(now())
  expiry_date          DateTime?
  reference_number     String?
  customer_id          String?
  location_id          String?
  sales_order_id       String?
  project_id           String?
  customer_notes       String?
  terms_and_conditions String?
  total_amount         Float?          @default(0.00)
  status               String?
  created_by           String?
  created_at           DateTime?       @default(now())
  modified_by          String?
  modified_at          DateTime?       @default(now()) @updatedAt
  org_id               String?
  assigned_to          String?
  name                 String?
  // Relations
  customer             customers?      @relation(fields: [customer_id], references: [id])
  location             location?       @relation(fields: [location_id], references: [id])
  sales_order          sales_order?    @relation(fields: [sales_order_id], references: [id])
  project              project_master? @relation(fields: [project_id], references: [id])
  quote_items          quote_item[]

  @@map("quote")
}

model quote_item {
  id               String       @id @default(dbgenerated("concat('quote_item_', gen_random_uuid())")) @db.VarChar(50)
  quote_id         String
  item_master_id   String?
  item_name        String?
  item_number      String?
  item_description String?
  item_type        String?
  quantity         Float?
  rate             Float?
  discount_rate    Float?
  discount_amount  Float?
  tax_rate         Float?
  tax_amount       Float?
  line_total       Float?
  uom              String?
  created_by       String?
  created_at       DateTime?    @default(now())
  modified_by      String?
  modified_at      DateTime?    @default(now()) @updatedAt
  org_id           String?
  assigned_to      String?
  name             String?
  // Relations
  quote            quote        @relation(fields: [quote_id], references: [id])
  item_master      item_master? @relation(fields: [item_master_id], references: [id])

  @@map("quote_item")
}
