// Shared reference data used by the kernel. Domain models go in domain.prisma.

model currency {
  id             String   @id @default(dbgenerated("'curr_' || gen_random_uuid()")) @db.VarChar(50)
  code           String   @unique
  name           String
  symbol         String?
  decimal_places Int      @default(2)
  is_active      Boolean  @default(true)
  org_id         String
  created_by     String?
  modified_by    String?
  created_at     DateTime @default(now())
  modified_at    DateTime @updatedAt
  orgs           org[]

  @@map("currency")
}

model attachment {
  id          String   @id @default(dbgenerated("'att_' || gen_random_uuid()")) @db.VarChar(50)
  path        String
  instance_id String
  type_name   String
  name        String
  org_id      String?
  created_by  String?
  modified_by String?
  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  @@index([type_name, instance_id])
  @@map("attachment")
}
