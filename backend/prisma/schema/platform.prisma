// Platform models are storage the kernel uses with no domain installed.
// A model belongs here only when kernel code reads or writes it, and it is
// not a catalog of product objects. Shared rows are seeded on org_system,
// and only the rows the engine needs. Domain models go in domain.prisma.
//
// currency — org.basecurrency_id. Seed is one USD row. Further codes are
// domain seed data on this same model, not new kernel models.
// attachment — upload routes write a row per file. No shared seed.

model currency {
  id             String   @id @default(dbgenerated("'curr_' || gen_random_uuid()")) @db.VarChar(50)
  code           String   @unique
  name           String
  symbol         String?
  decimal_places Int      @default(2)
  is_active      Boolean  @default(true)
  org_id         String
  created_by     String?
  modified_by    String?
  created_at     DateTime @default(now())
  modified_at    DateTime @updatedAt
  orgs           org[]

  @@map("currency")
}

model attachment {
  id          String   @id @default(dbgenerated("'att_' || gen_random_uuid()")) @db.VarChar(50)
  path        String
  instance_id String
  type_name   String
  name        String
  org_id      String?
  created_by  String?
  modified_by String?
  created_at  DateTime @default(now())
  modified_at DateTime @updatedAt

  @@index([type_name, instance_id])
  @@map("attachment")
}
