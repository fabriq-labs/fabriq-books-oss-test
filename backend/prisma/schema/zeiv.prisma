model item_master {
  id                    String                  @id @default(dbgenerated("concat('prod_',  gen_random_uuid())")) @db.VarChar(50)
  item_code             String?                 @unique @db.VarChar(20)
  item_name             String
  name                  String?
  item_shortname        String?
  item_description      String
  item_type             String?
  sales_account_id      String?
  purchase_account_id   String?
  unit_price            Float?
  uom_id                String?
  stockable             String?
  item_status           String?
  lead_time             Float?
  expiry_date           DateTime?               @default(now()) @db.Timestamp(6)
  supplier_id           String?
  preferred_supplier    String?
  search_keywords       String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  created_by            String?
  modified_by           String?
  modified_at           DateTime?               @default(now()) @db.Timestamp(6)
  assigned_to           String?
  org_id                String?
  product_id            String?
  item_category_id      String?
  tax_master_id         String?
  tax_rate_intra_id     String?
  currency_id           String?
  supplier              supplier?               @relation(fields: [supplier_id], references: [id])
  item_category         item_category?          @relation(fields: [item_category_id], references: [id])
  uom                   uom?                    @relation(fields: [uom_id], references: [id])
  tax_master            tax_master?             @relation("ItemMaster_TaxMaster", fields: [tax_master_id], references: [id])
  tax_rate_intra        tax_master?             @relation("ItemMaster_TaxRateIntra", fields: [tax_rate_intra_id], references: [id])
  currency              currency?               @relation(fields: [currency_id], references: [id])
  sales_account         account?                @relation("ItemMaster_SalesAccount", fields: [sales_account_id], references: [id])
  purchase_account      account?                @relation("ItemMaster_PurchaseAccount", fields: [purchase_account_id], references: [id])
  pr_items              item[]
  supplier_items        supplier_items[]
  puchase_order_item    purchase_order_item[]
  invoice_line_item     invoice_line_item[]
  sales_order_item      sales_order_item[]
  delivery_challan_item delivery_challan_item[]
  credit_note_item      credit_note_item[]
