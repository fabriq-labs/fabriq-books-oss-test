model item {
  id                  String                @id @default(dbgenerated("concat('item_',  gen_random_uuid())")) @db.VarChar(50)
  item_number         String?
  item_name           String?
  instance_id         String?
  product_id          String?
  item_code           String?
  item_description    String?
  item_type           String?
  uom                 String?
  rate                Float?
  quantity            Float?
  item_total          Float?
  need_by_date        DateTime?
  supplier_id         String?
  created_at          DateTime?             @default(now())
  created_by          String?
  modified_by         String?
  modified_at         DateTime?             @updatedAt
  org_id              String?
  budget_period_id    String?
  budget_line_id      String?
  cost_center_id      String?
  pr_details          purchase_requisition? @relation(fields: [instance_id], references: [id])
  product             item_master?          @relation(fields: [product_id], references: [id])
  supplier            supplier?             @relation(fields: [supplier_id], references: [id])
  budget_period       budget_period?        @relation(fields: [budget_period_id], references: [id])
  budget_line         budget_line?          @relation(fields: [budget_line_id], references: [id])
  cost_center         cost_center?          @relation(fields: [cost_center_id], references: [id])
  purchase_order_item purchase_order_item[]

  @@unique([instance_id, item_number])
}

model purchase_order {
  id                   String                @id @default(dbgenerated("concat('po_',  gen_random_uuid())")) @db.VarChar(50)
  po_number            String?               @unique
  pr_number            String?
  po_date              DateTime?             @default(now())
  pr_date              DateTime?
  on_behalf            Boolean?
  on_behalf_of         Boolean?
  on_behalf_department String?
  requester            String?
  requester_department String?
  wf_instance_id       String?
  deliver_to           String?
  location_id          String?
  account_id           String?
  purchase_reason      String?
  request_for_project  Boolean?
  project_master_id    String?
  budget_period_id     String?
  budget_line_id       String?
  created_at           DateTime?             @default(now())
  created_by           String?
  modified_by          String?
  modified_at          DateTime?             @updatedAt
  assigned_to          String?
  org_id               String?
  total_price          Float?                @default(0.00)
  department_id        String?               @db.VarChar(50)
  comment              String?
  status               String?
  purchase_id          String?
  need_by_date         DateTime?
  pr_total             Float?
  delivery_address     String?
  shipping_method_id   String?
  shipping_terms_id    String?
  payment_terms_id     String?
  supplier_id          String?
  legal_entity_id      String?
  workflow_instance    workflow_instance?    @relation(fields: [wf_instance_id], references: [id])
  department           department?           @relation(fields: [department_id], references: [id])
  account              account?              @relation(fields: [account_id], references: [id])
  budget_line          budget_line?          @relation(fields: [budget_line_id], references: [id])
  budget_period        budget_period?        @relation(fields: [budget_period_id], references: [id])
  project_master       project_master?       @relation(fields: [project_master_id], references: [id])
  purchase_requisition purchase_requisition? @relation(fields: [purchase_id], references: [id])
  supplier_details     supplier?             @relation(fields: [supplier_id], references: [id])
  location             location?             @relation(fields: [location_id], references: [id])
  legal_entity         entity?               @relation(fields: [legal_entity_id], references: [id])
  shipping_method      shipping_method?      @relation(fields: [shipping_method_id], references: [id])
  shipping_terms       shipping_terms?       @relation(fields: [shipping_terms_id], references: [id])
  payment_terms        payment_terms?        @relation(fields: [payment_terms_id], references: [id])
  purchase_order_item  purchase_order_item[]
  name                 String?
  invoice              invoice[]
  // Lineage fields for data integration tracking
  source_system_id     String?               @default("srcsys_fabriq") // FK to datalake.source_system (default: fabriq for internal records)
  source_record_id     String? // Source system record ID (e.g., external system PO ID)
  source_updated_at    DateTime?             @default(now()) // Last updated in source system (default: now() for internal records)
  ingest_batch_id      String? // FK to datalake.sync_batch
  // External sync status (for Fabriq → external system sync)
  sync_status          String? // 'pending' | 'synced' | 'failed' - status of sync to external system

  @@index([source_system_id, source_record_id])
  @@index([source_updated_at])
}

model purchase_order_item {
  id                      String               @id @default(dbgenerated("concat('po_item_',  gen_random_uuid())")) @db.VarChar(50)
  purchase_order_item_no  String?
  purchase_requisition_id String
  instance_id             String
  product_id              String
  item_code               String?
  item_description        String?
  item_type               String?
  uom                     String?
  rate                    Float?
  quantity                Float?
  item_total              Float?
  need_by_date            DateTime?
  supplier_id             String?
  created_at              DateTime?            @default(now())
  created_by              String?
  modified_by             String?
  modified_at             DateTime?            @updatedAt
  org_id                  String?
  item_id                 String?
  item_name               String?
  ordered_quantity        Int?
  ordered_amount          Float?
  invoice_qty             Int?
  invoiced_amount         String?
  assigned_to             String?
  status                  String?
  purchase_requisition    purchase_requisition @relation(fields: [purchase_requisition_id], references: [id])
  product                 item_master?         @relation(fields: [product_id], references: [id])
  item                    item?                @relation(fields: [item_id], references: [id])
  purchase_order          purchase_order       @relation(fields: [instance_id], references: [id])
  name                    String?
  supplier                supplier?            @relation(fields: [supplier_id], references: [id])
  invoice_line_item       invoice_line_item[]
  invoice                 invoice[]
}

model invoice {
  id                           String    @id @default(dbgenerated("concat('invoice_',  gen_random_uuid())")) @db.VarChar(50)
  invoice_number               String?
  invoice_date                 DateTime  @default(now())
  invoice_version              Int?
  invoice_status               String?
  invoice_type                 String? // 'SALES' or 'PURCHASE' (business classification)
  transaction_type             String? // transaction type (renewal, invoice, etc.)
  supplier_name                String?
  attach                       String?
  supplier_remarks             String?
  shipping_terms               String?
  shipping_method              String?
  payment_terms                String?
  remit_to                     String?
  wf_instance_id               String?
  bill_to                      String?
  deliver_to                   String?
  requester_name               String?
  requester_email              String?
  ap_comment                   String?
  po_number                    String?
  account_id                   String?
  additional_tax               Float?
  shipping_cost                Float?
  tax_on_shipping              Float?
  handling_cost                Float?
  tax_on_handling              Float?
  misc_cost                    Float?
  tax_on_misc                  Float?
  invoice_net_total            Float?
  shipping_handling_misc_total Float?
  invoice_total                Float?
  balance_amount               Float?
  purchase_order_id            String?
  legal_entity_id              String?
  purchase_order_item_id       String?
  sales_order_id               String?
  name                         String?
  status                       String?
  created_by                   String?
  created_at                   DateTime? @default(now())
  modified_by                  String?
  modified_at                  DateTime? @default(now())
  org_id                       String?
  tax_total                    Float?
  assigned_to                  String?
  location_id                  String?
  customer_id                  String?
  terms_and_conditions         String?
  notes                        String?
  // Lineage fields for data integration tracking
  source_system_id             String?   @default("srcsys_fabriq") // FK to datalake.source_system (default: fabriq for internal records)
  source_record_id             String? // Source system record ID (e.g., Zoho invoice_id)
  source_updated_at            DateTime? @default(now()) // Last updated in source system (default: now() for internal records)
  ingest_batch_id              String? // FK to datalake.sync_batch

  workflow_instance   workflow_instance?   @relation(fields: [wf_instance_id], references: [id])
  purchase_order      purchase_order?      @relation(fields: [purchase_order_id], references: [id])
  purchase_order_item purchase_order_item? @relation(fields: [purchase_order_item_id], references: [id])
  location            location?            @relation(fields: [location_id], references: [id])
  customers           customers?           @relation(fields: [customer_id], references: [id])
  sales_order         sales_order?         @relation(fields: [sales_order_id], references: [id])
  account             account?             @relation(fields: [account_id], references: [id])
  legal_entity        entity?              @relation(fields: [legal_entity_id], references: [id])
  invoice_line_item   invoice_line_item[]
  payment_receipt     payment_receipt[]
  credit_note         credit_note[]

  @@index([source_system_id, source_record_id])
  @@index([source_updated_at])
}

model invoice_line_item {
  id                       String                @id @default(dbgenerated("concat('in_item__',  gen_random_uuid())")) @db.VarChar(50)
  item_name                String?
  item_number              String?
  item_description         String?
  item_type                String?
  rate                     Float?
  ordered_quantity         Float?
  ordered_amount           Float?
  invoice_qty              Int?
  line_total               Float?
  invoiced_amount          Float?
  tax_type                 String?
  tax_rate                 Float?
  tax_rate_intra           Float?
  line_tax_amount          Float?
  po_number                String?
  purchase_order_item_id   String?
  item_master_id           String?
  instance_id              String
  purchase_requisition_id  String?
  name                     String?
  created_by               String?
  need_by_date             DateTime?
  created_at               DateTime              @default(now())
  modified_by              String?
  modified_at              DateTime              @default(now())
  org_id                   String?
  assigned_to              String?
  discount_rate            Float?
  discount_amount          Float?
  purchase_order_line_item purchase_order_item?  @relation(fields: [purchase_order_item_id], references: [id])
  item_master              item_master?          @relation(fields: [item_master_id], references: [id])
  invoice                  invoice               @relation(fields: [instance_id], references: [id])
  purchase_requisition     purchase_requisition? @relation(fields: [purchase_requisition_id], references: [id])
  credit_note_item         credit_note_item[]
}

enum payment_type {
  FULL
  PARTIAL
  ADVANCE
}

model payment_receipt {
  id                String        @id @default(dbgenerated("concat('payr_', gen_random_uuid())")) @db.VarChar(50)
  receipt_number    String?       @unique
  receipt_date      DateTime?     @default(now())
  customer_id       String?
  invoice_id        String? // Direct reference to invoice (null for advance payments)
  payment_reference String?
  amount            Float?
  payment_method    String?
  currency_id       String?
  exchange_rate     Float?        @default(1.00)
  base_amount       Float?
  payment_type      payment_type? // 'FULL', 'PARTIAL', 'ADVANCE'
  notes             String?
  account_id        String?
  status            String?
  created_by        String?
  modified_by       String?
  created_at        DateTime?     @default(now())
  modified_at       DateTime?     @updatedAt
  org_id            String?
  assigned_to       String?
  // Lineage fields for data integration tracking
  source_system_id  String?       @default("srcsys_fabriq") // FK to datalake.source_system (default: fabriq for internal records)
  source_record_id  String? // Source system record ID (e.g., Zoho payment_id)
  source_updated_at DateTime?     @default(now()) // Last updated in source system (default: now() for internal records)
  ingest_batch_id   String? // FK to datalake.sync_batch
  // Back-relation from posting (posting.payment_receipt_id points here)
  posting           posting?      @relation("PostingToPaymentReceipt")
  // Relationships
  customers         customers?    @relation(fields: [customer_id], references: [id])
  invoice           invoice?      @relation(fields: [invoice_id], references: [id])
  currency          currency?     @relation(fields: [currency_id], references: [id])

  account account? @relation(fields: [account_id], references: [id])

  @@index([source_system_id, source_record_id])
  @@index([source_updated_at])
}
