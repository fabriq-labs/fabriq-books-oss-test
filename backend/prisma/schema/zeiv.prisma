}

model attachment {
  id          String   @id @default(dbgenerated("concat('attach_', gen_random_uuid())")) @db.VarChar(50)
  path        String
  instance_id String
  type_id     Int?
  type_name   String
  name        String
  created_by  String?
  created_at  DateTime @default(now())
  modified_by String?
  modified_at DateTime @default(now())
  org_id      String?
  assigned_to String?
}

model instance_email_ingest {
  id               String    @id @default(dbgenerated("concat('emig_', gen_random_uuid())")) @db.VarChar(50)
  org_id           String?
  gmail_message_id String?
  gmail_thread_id  String?
  from_email       String?
  to_email         String?
  subject          String?
  received_at      DateTime?
  body_snippet     String?
  model_name       String?
  status           String?
  error_message    String?
  created_by       String?
  created_at       DateTime? @default(now())
  modified_by      String?
  modified_at      DateTime? @default(now())
  processed_at     DateTime?

  instance_email_ingest_item instance_email_ingest_item[]

  @@index([org_id, gmail_message_id])
  @@index([status])
}

model instance_email_ingest_item {
  id                       String    @id @default(dbgenerated("concat('emig_item_', gen_random_uuid())")) @db.VarChar(50)
  org_id                   String?
  instance_email_ingest_id String
  model_name               String?
  attachment_filename      String?
  extracted_data           Json?
  instance_id              String?
  status                   String?
  staged_path              String?
  rejection_reason         String?
  created_by               String?
  created_at               DateTime? @default(now())
  modified_by              String?
  modified_at              DateTime? @default(now())

  instance_email_ingest instance_email_ingest @relation(fields: [instance_email_ingest_id], references: [id])

  @@index([instance_email_ingest_id])
  @@index([status])
}

model location {
  id                   String                 @id @default(dbgenerated("concat('loca_',  gen_random_uuid())")) @db.VarChar(50)
  location             String
  name                 String?
  legal_entity_id      String?
  customer_id          String?
  address              String
  city                 String
  state                String
  country              String
  zip_code             String
  website              String?
  full_address         String?
  created_by           String?
  created_at           DateTime?
  modified_by          String?
  modified_at          DateTime               @default(now())
  org_id               String?
  assigned_to          String?
  employee_master      employee_master[]
  legal_entity         entity?                @relation(fields: [legal_entity_id], references: [id])
  customers            customers?             @relation(fields: [customer_id], references: [id])
  purchase_requisition purchase_requisition[]
  purchase_order       purchase_order[]
  invoice              invoice[]
  sales_order          sales_order[]
  delivery_challan     delivery_challan[]
  credit_note          credit_note[]
  quote                quote[]
}

model supplier {
  id                        String                @id @default(dbgenerated("concat('supp_',  gen_random_uuid())")) @db.VarChar(50)
  supplier_name             String
  supplier_address          String
  city                      String
  state                     String
  name                      String?
  country                   String
  zip_code                  String
  primary_phone             String?
  alternative_phone         String?
  primary_email             String
  secondary_email           String?
  po_email                  String?
  status                    String
  industry                  String
  website                   String?
  employee_count            Int?
  legal_name                String
  legal_registration_number String?
  business_classification   String
  buyer_review_added        String
  onboarded_date            DateTime
  created_by                String?
  modified_by               String?
  org_id                    String
  assigned_to               String?
  created_at                DateTime?             @default(now()) @db.Timestamp(6)
  modified_at               DateTime?             @default(now()) @db.Timestamp(6)
  supplier_id               String?
  payment_term_id           String?
  shipping_term_id          String?
  shipping_method_id        String?
  preferred_currency_id     String?
  products                  item_master[]
  shipping_method           shipping_method?      @relation(fields: [shipping_method_id], references: [id])
  shipping_terms            shipping_terms?       @relation(fields: [shipping_term_id], references: [id])
  payment_terms             payment_terms?        @relation(fields: [payment_term_id], references: [id])
  currency                  currency?             @relation(fields: [preferred_currency_id], references: [id])
  supplier_items            supplier_items[]
  item                      item[]
  purchase_order_item       purchase_order_item[]
  purchase_order            purchase_order[]
  // Lineage fields for data integration tracking
  source_system_id          String?               @default("srcsys_fabriq") // FK to datalake.source_system (default: fabriq for internal records)
  source_record_id          String? // Source system record ID (e.g., Zoho contact_id)
  source_updated_at         DateTime?             @default(now()) // Last updated in source system (default: now() for internal records)
  ingest_batch_id           String? // FK to datalake.sync_batch

  @@index([source_system_id, source_record_id])
  @@index([source_updated_at])
}

model customers {
  id                    String             @id @default(dbgenerated("concat('cust_',  gen_random_uuid())")) @db.VarChar(50)
  customer_name         String
  customer_address      String
  city                  String
  state                 String
  country               String
  zip_code              String
  primary_phone         String?
  primary_email         String
  industry              String
  website               String?
  created_by            String?
  modified_by           String?
  org_id                String
  assigned_to           String?
  created_at            DateTime?          @default(now()) @db.Timestamp(6)
  modified_at           DateTime?          @default(now()) @db.Timestamp(6)
  payment_term_id       String?
  preferred_currency_id String?
  payment_terms         payment_terms?     @relation(fields: [payment_term_id], references: [id])
  currency              currency?          @relation(fields: [preferred_currency_id], references: [id])
  invoice               invoice[]
  location              location[]
  payment_receipt       payment_receipt[]
  sales_order           sales_order[]
  delivery_challan      delivery_challan[]
  credit_note           credit_note[]
