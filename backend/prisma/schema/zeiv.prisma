enum financial_year_type {
  JAN_DEC
  APR_MAR
  JUL_JUN
  OCT_SEP
}

model entity {
  id                   String                 @id @default(dbgenerated("concat('org_', gen_random_uuid())")) @db.VarChar(50)
  organization_name    String
  legal_name           String
  address              String
  city                 String
  state                String
  country              String
  zip_code             String
  website              String?
  is_it_headquartres   String
  is_it_a_groupcompany String
  group_company_name   String?
  basecurrency_id      String?
  created_by           String?
  created_at           DateTime?
  modified_by          String?
  modified_at          DateTime               @default(now())
  org_id               String
  assigned_to          String?
  name                 String?
  is_individual        Boolean                @default(false)
  financial_year_type  financial_year_type?
  currency             currency?              @relation(fields: [basecurrency_id], references: [id])
  business_unit        business_unit[]
  location             location[]
  employee_master      employee_master[]
  cost_center          cost_center[]
  payment_terms        payment_terms[]
  account              account[]
  general_ledger       general_ledger[]
  project_master       project_master[]
  department           department[]
  purchase_requisition purchase_requisition[]
  purchase_order       purchase_order[]
  invoice              invoice[]
  posting              posting[]
}

model budget_period {
  id                   String                 @id @default(dbgenerated("concat('bupe_',  gen_random_uuid())")) @db.VarChar(50)
  budget_period        String?
  from_date            DateTime?
  to_date              DateTime?
  account_id           String?
  status               String?
  created_by           String
  created_at           DateTime?
  created_date         DateTime?              @default(now())
  modified_by          String?
  assigned_to          String?
  org_id               String?
  modified_at          DateTime?
  account              account?               @relation(fields: [account_id], references: [id])
  budget_line          budget_line[]
  purchase_requisition purchase_requisition[]
  purchase_order       purchase_order[]
  item                 item[]
}

model item_category {
  id               String        @id @default(dbgenerated("concat('item_',  gen_random_uuid())")) @db.VarChar(50)
  item_category    String
  item_subcategory String?
  created_by       String?
  created_at       DateTime?
  modified_by      String?
