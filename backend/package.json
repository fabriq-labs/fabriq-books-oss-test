{
  "name": "fabriq-backend",
  "version": "1.0.0",
  "description": "Fabriq Books API backend — metadata-driven REST/GraphQL, workflows, and AI agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/config', 'dist/config', {recursive: true, force: true})\"",
    "start": "node dist/index.js",
    "dev": "node -r dotenv/config ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:suite": "jest --config jest.config.suite.js",
    "test:watch": "jest --watch",
    "test:posting-prompt": "ts-node --transpile-only src/agent/__tests__/posting-prompt.test.ts",
    "test:posting-sample-questions": "DOTENV_CONFIG_PATH=.env node -r dotenv/config ./node_modules/.bin/ts-node --transpile-only src/agent/__tests__/posting-sample-questions.test.ts",
    "test:import-api-key": "jest src/__tests__/import/bank-statement-import-api-key.test.ts",
    "generate:sample-bank-pdf": "ts-node --transpile-only scripts/generate-us-ca-sample-bank-pdf.ts",
    "generate-types": "ts-node scripts/generateTypes.ts",
    "slides": "slidev --open src/agent/slides.md",
    "apply-views": "ts-node src/utils/setup/applyDatabaseViews.ts",
    "sync-metadata": "ts-node prisma/sync-metadata.ts",
    "seed-sql-metadata": "ts-node prisma/seed-sql-metadata.ts",
    "setup:kernel": "node scripts/setup-kernel-db.js",
    "seed:gl": "ts-node --transpile-only src/utils/setup/seedGl.ts",
    "pull-metadata": "ts-node prisma/pull-metadata.ts",
    "pull": "ts-node prisma/pull-metadata-interactive.ts",
    "sync": "ts-node prisma/sync-metadata-interactive.ts",
    "remove-tenant-data": "ts-node prisma/remove-tenant-data.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^2.2.27",
    "@ai-sdk/openai": "^1.3.24",
    "@apollo/client": "^3.13.6",
    "@apollo/server": "^4.9.5",
    "@clerk/clerk-sdk-node": "^5.1.6",
    "@google-cloud/storage": "^7.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "@slack/web-api": "^7.12.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "ai": "^4.3.15",
    "apollo-server-express": "^3.12.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "multer": "^2.0.0",
    "plaid": "^42.2.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@slidev/cli": "^0.50.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.37",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
