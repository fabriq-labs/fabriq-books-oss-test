# ============================================================
# .env.test.example — Test environment for Claude Code web sessions
#
# Copy to .env.test before running tests:
#   cp backend/.env.test.example backend/.env.test
#
# All values here are safe test defaults. The only line you may
# need to change is DATABASE_URL if your local postgres differs.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Matches the DB created in the cloud session setup steps
DATABASE_URL="postgresql://fabriq:fabriq@localhost:5432/fabriq_dev"

# ── App ──────────────────────────────────────────────────────
NODE_ENV=test
APP_NAME=fabriq
LOG_LEVEL=warn

# ── Auth ─────────────────────────────────────────────────────
# local auth — no Clerk/Supertokens needed for tests
AUTH_PROVIDER=local

# Dummy symmetric JWT secret — sufficient for local auth in tests
JWT_SECRET=test-jwt-secret-do-not-use-in-production-minimum-32-chars

# RSA keypair fields — required by the auth module even in local mode.
# These are throwaway test keys, never used for real tokens.
AUTH_SECRET_KEY=test-secret-key-placeholder
AUTH_PUBLIC_KEY=test-public-key-placeholder

# ── Permissions ──────────────────────────────────────────────
# Skip permission checks so tests don't need to set up role/view fixtures
SKIP_PERMISSION_CHECKS=true
PRISMA_SHOW_QUERY=false

# ── LLM ──────────────────────────────────────────────────────
# All LLM calls in the categorization-v2 test suite are mocked.
# These values are placeholders — no real API key is needed.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=sk-or-test-placeholder-not-a-real-key

# ── Storage ──────────────────────────────────────────────────
# Use local filesystem storage — no GCS bucket needed for tests
STORAGE_TYPE=local
STORAGE_FOLDER_PATH=/tmp/fabriq-test-uploads
BUCKET_NAME=fabriq-test-local
GOOGLE_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT_ID=fabriq-test

# ── Encryption ───────────────────────────────────────────────
# 32-byte base64 key required by ERP config encryption.
# This is a dummy key safe for test use only.
ERP_CONFIG_ENCRYPTION_KEY=dGVzdC1lbmNyeXB0aW9uLWtleS0zMmJ5dGVzLTE=

# ── Email ────────────────────────────────────────────────────
# Disabled in test — no emails sent
SMTP2GO_API_KEY=test-smtp-key-placeholder
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send
SMTP2GO_SENDER=test@fabriq.test
SMTP2GO_BCC=
SMTP2GO_CC=

# ── ERP Integrations ─────────────────────────────────────────
# Not used in categorization tests — set to placeholder values
ERP_TYPE=none
INTEGRATION_SYNC_URL=http://localhost:8080

ZOHO_CLIENT_ID=test-zoho-client-id
ZOHO_CLIENT_SECRET=test-zoho-client-secret
ZOHO_REFRESH_TOKEN=test-zoho-refresh-token
ZOHO_ORGANIZATION_ID=test-zoho-org
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_REDIRECT_URI=http://localhost:4000/api/zoho/callback
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

QUICKBOOKS_CLIENT_ID=test-qb-client-id
QUICKBOOKS_CLIENT_SECRET=test-qb-client-secret
QUICKBOOKS_REFRESH_TOKEN=test-qb-refresh-token
QUICKBOOKS_REALM_ID=test-qb-realm
QUICKBOOKS_ENVIRONMENT=sandbox

AIRBYTE_CLIENT_ID=test-airbyte-client-id
AIRBYTE_CLIENT_SECRET=test-airbyte-client-secret
AIRBYTE_CONNECTION_ID_ZOHO=test-airbyte-conn-zoho
AIRBYTE_CONNECTION_ID_QUICKBOOKS=test-airbyte-conn-qb
AIRBYTE_API_BASE=https://api.airbyte.com

# ── Demo ─────────────────────────────────────────────────────
ALLOW_DEMO_RESET_API=false

# ── Test-specific overrides ───────────────────────────────────
# Org and user IDs used by the categorization-v2 fixture setup
TEST_ORG_ID=org_test_cat_v2
TEST_USER_ID=user_test_cat_v2
