# Copy to backend/.env.test before tests that need a database:
#   cp backend/.env.test.example backend/.env.test
#
# Values here are local test defaults. Change DATABASE_URL if Postgres is elsewhere.

DATABASE_URL=postgresql://kernel:kernel@localhost:5432/kernel_app
NODE_ENV=test
LOG_LEVEL=warn
AUTH_PROVIDER=local
JWT_SECRET=test-jwt-secret-do-not-use-in-production-minimum-32-chars
SKIP_PERMISSION_CHECKS=true
PRISMA_SHOW_QUERY=false
