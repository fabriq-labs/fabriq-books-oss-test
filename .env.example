# Repo-root shared runtime env for backend + integrations (+ Docker env_file).
# Copy to `.env` at the repo root. Do not commit `.env`.
# Vite build vars stay in frontend-0/.env* (VITE_* only).

DATABASE_URL=postgresql://kernel:kernel@localhost:5432/kernel_app
JWT_SECRET=change-me-to-a-long-random-string
AUTH_PROVIDER=local
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Required once ERP connections / sync are used (32-byte key, base64-encoded).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# ERP_CONFIG_ENCRYPTION_KEY=

# Airbyte (only for npm run integrations:set-extraction-config)
# AIRBYTE_CLIENT_ID=
# AIRBYTE_CLIENT_SECRET=
# AIRBYTE_API_BASE=https://api.airbyte.com

# Single-container sync/dbt (loopback). Defaults are fine for local Docker.
# ENABLE_SYNC_SERVICE=true
# SYNC_PORT=8090
# SYNC_SERVICE_URL=http://127.0.0.1:8090
# SKIP_AIRBYTE=true
# DBT_THREADS=2
# FORCE_PROCESS_ALL=false
# ORG_ID=

# Ops only (not read by the API)
# RAILWAY_TOKEN=
