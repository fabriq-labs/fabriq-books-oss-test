# Repo-root shared runtime env for backend + integrations (+ Docker env_file).
# Copy to `.env` at the repo root. Do not commit `.env`.
# Vite build vars stay in frontend-0/.env* (VITE_* only).

DATABASE_URL=postgresql://kernel:kernel@localhost:5432/kernel_app
JWT_SECRET=change-me-to-a-long-random-string
AUTH_PROVIDER=local
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Opt-in first-boot schema + minimum seed (start.sh / docker compose).
# Unset or false: container starts without migrating (manual setup:kernel).
# docker-compose.yml sets AUTO_SETUP=true for the local happy path.
# AUTO_SETUP=true

# Required once ERP connections / sync are used (32-byte key, base64-encoded).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ERP_CONFIG_ENCRYPTION_KEY=

# ── Airbyte (paste values into `.env`; do not commit the filled file) ────────
# The running import reads the encrypted copy stored on the connection.
# These names are for the one-shot setup script, from backend/:
#   npm run integrations:set-extraction-config -- \
#     --source-system-id "$SOURCE_SYSTEM_ID" \
#     --airbyte-connection-id "$AIRBYTE_CONNECTION_ID"
# That script loads backend/.env and reads AIRBYTE_CLIENT_ID / AIRBYTE_CLIENT_SECRET
# from the environment. Pass the two ids as the flags above.
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_API_BASE=https://api.airbyte.com
# Airbyte connection UUID (not the QuickBooks company id). Flag value, not read by itself.
AIRBYTE_CONNECTION_ID=
# Books source_system id from the connection page after save (srcsys_…). Flag value.
SOURCE_SYSTEM_ID=

# Single-container sync/dbt (loopback)
ENABLE_SYNC_SERVICE=true
SYNC_PORT=8090
SYNC_SERVICE_URL=http://127.0.0.1:8090
# SKIP_AIRBYTE=true
# DBT_THREADS=2
# FORCE_PROCESS_ALL=false
# ORG_ID=

# Ops only (not read by the API)
# RAILWAY_TOKEN=
